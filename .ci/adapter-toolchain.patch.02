diff --git a/adapters/react-native/android/include.init.gradle b/adapters/react-native/android/include.init.gradle
new file mode 100644
index 0000000..562b437
--- /dev/null
+++ b/adapters/react-native/android/include.init.gradle
@@ -0,0 +1,13 @@
+def adapterProjectDir = gradle.startParameter.projectProperties['fresnicaAdapterProjectDir']
+if (adapterProjectDir == null || adapterProjectDir.trim().isEmpty()) {
+    throw new GradleException('Missing required Gradle property: fresnicaAdapterProjectDir')
+}
+
+gradle.settingsEvaluated { settings ->
+    def adapterPath = ':fresnicaReactNativeAdapter'
+    if (settings.findProject(adapterPath) != null) {
+        throw new GradleException("Consumer build already defines ${adapterPath}")
+    }
+    settings.include(adapterPath)
+    settings.project(adapterPath).projectDir = new File(adapterProjectDir)
+}
