+String optionalProperty(String name) {
+    def value = providers.gradleProperty(name).orNull
+    return value == null || value.trim().isEmpty() ? null : value.trim()
+}
+
 def nativeSdkAar = file(requiredProperty('fresnicaNativeSdkAar'))
 def reactNativeVersion = requiredProperty('fresnicaReactNativeVersion')
+def compileSdkValue = optionalProperty('fresnicaCompileSdk')
+if (compileSdkValue == null && rootProject.ext.has('compileSdkVersion')) {
+    compileSdkValue = rootProject.ext.compileSdkVersion.toString()
+}
+if (compileSdkValue == null) {
+    throw new GradleException(
+        'Cannot determine consumer compileSdk. Expose rootProject.ext.compileSdkVersion ' +
+        'or pass -PfresnicaCompileSdk=<consumer compileSdk>.'
+    )
+}
 
 if (!nativeSdkAar.isFile()) {
     throw new GradleException("Fresnica Native SDK AAR not found: ${nativeSdkAar}")
 }
 
+// AGP 9+ normally compiles Kotlin itself. Older hosts (and AGP 9 hosts that
+// explicitly opt out of built-in Kotlin) supply their own Kotlin Android
+// plugin from the consumer build classpath. Fresnica never chooses its version.
+def agpMajor = com.android.Version.ANDROID_GRADLE_PLUGIN_VERSION.tokenize('.')[0] as int
+def builtInKotlinDisabled = optionalProperty('android.builtInKotlin') == 'false'
+def needsConsumerKotlinPlugin = agpMajor < 9 || builtInKotlinDisabled
+if (needsConsumerKotlinPlugin) {
+    try {
+        apply plugin: 'org.jetbrains.kotlin.android'
+    } catch (Exception error) {
+        throw new GradleException(
+            'This consumer Android toolchain requires the Kotlin Android plugin to compile the ' +
+            'Fresnica adapter. Make the Kotlin plugin already used by the consumer build available ' +
+            'to subprojects; Fresnica intentionally does not select a Kotlin plugin version.',
+            error,
+        )
+    }
+}
